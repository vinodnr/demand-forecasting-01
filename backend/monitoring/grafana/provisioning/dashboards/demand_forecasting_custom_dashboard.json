{
  "dashboard": {
    "id": null,
    "title": "Demand Forecasting \u2014 Operations Dashboard (Custom)",
    "uid": "demand-forecasting-ops",
    "timezone": "browser",
    "schemaVersion": 30,
    "version": 1,
    "refresh": "30s",
    "templating": {
      "list": [
        {
          "type": "query",
          "name": "provider",
          "label": "Provider",
          "query": "label_values(llm_tokens_used_total, provider)",
          "datasource": "Prometheus",
          "includeAll": true,
          "allValue": ".*"
        },
        {
          "type": "query",
          "name": "org",
          "label": "Org",
          "query": "label_values(llm_tokens_used_total, org_id)",
          "datasource": "Prometheus",
          "includeAll": false
        }
      ]
    },
    "panels": [
      {
        "type": "timeseries",
        "title": "HTTP Requests per second (1m)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[1m]))",
            "legendFormat": "requests/s"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqs"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "type": "timeseries",
        "title": "Request Latency p95 (5m)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_latency_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 0.3,
                  "color": "yellow"
                },
                {
                  "value": 0.5,
                  "color": "red"
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "alert": {
          "name": "High P95 Latency",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0.5
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": [
                  "A",
                  "5m"
                ]
              },
              "reducer": {
                "type": "avg",
                "params": []
              }
            }
          ],
          "for": "15m",
          "frequency": "1m",
          "noDataState": "no_data",
          "executionErrorState": "alerting"
        }
      },
      {
        "type": "timeseries",
        "title": "LLM Tokens Used (1h rate)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(llm_tokens_used_total[1h])) by (provider)",
            "legendFormat": "{{provider}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "alert": {
          "name": "High LLM Token Usage",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  100000
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": [
                  "A",
                  "1h"
                ]
              },
              "reducer": {
                "type": "sum",
                "params": []
              }
            }
          ],
          "for": "10m",
          "frequency": "1m",
          "noDataState": "ok",
          "executionErrorState": "alerting"
        }
      },
      {
        "type": "stat",
        "title": "Availability (30d SLO)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "slo:availability_30d",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "percentage",
              "steps": [
                {
                  "value": 0,
                  "color": "red"
                },
                {
                  "value": 99,
                  "color": "yellow"
                },
                {
                  "value": 99.9,
                  "color": "green"
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 12,
          "y": 8
        }
      },
      {
        "type": "stat",
        "title": "Latency p95 (7d)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "slo:latency_p95_7d",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 0.3,
                  "color": "yellow"
                },
                {
                  "value": 0.5,
                  "color": "red"
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 18,
          "y": 8
        },
        "alert": {
          "name": "High P95 Latency",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0.5
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": [
                  "A",
                  "5m"
                ]
              },
              "reducer": {
                "type": "avg",
                "params": []
              }
            }
          ],
          "for": "15m",
          "frequency": "1m",
          "noDataState": "no_data",
          "executionErrorState": "alerting"
        }
      },
      {
        "type": "table",
        "title": "Active Workers",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(active_worker_count) by (worker_name)",
            "refId": "C"
          }
        ],
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 0,
          "y": 16
        }
      },
      {
        "type": "timeseries",
        "title": "Error Rate (5xx) 5m",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{http_status=~\"5..\"}[5m]))",
            "legendFormat": "5xx"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqs"
          }
        },
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 12,
          "y": 16
        }
      },
      {
        "type": "timeseries",
        "title": "Error Budget Burn (availability)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "(1 - slo:availability_30d) * 100",
            "legendFormat": "error_budget_%"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 1,
                  "color": "yellow"
                },
                {
                  "value": 2,
                  "color": "red"
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 0,
          "y": 24
        }
      }
    ],
    "annotations": {
      "list": []
    }
  }
}