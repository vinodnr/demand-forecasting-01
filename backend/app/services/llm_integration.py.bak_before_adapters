from .llm_client import OpenAIClient
from . import llm_manager as manager
import logging

def get_llm_client_for_org(org_id=None, plan_id=None):
    """Return a provider-specific client instance for an org/plan. Falls back to OpenAIClient for unknown providers."""
    provider_key = manager.get_provider_for_org(org_id=org_id, plan_id=plan_id)
    if provider_key == 'openai':
        # Use OpenAIClient
        return OpenAIClient(api_key_env='OPENAI_API_KEY')
    elif provider_key == 'gemini':
        # Placeholder Gemini client adapter - implement actual client in future sprint
        return OpenAIClient(api_key_env='GEMINI_API_KEY')  # reuse wrapper for now; replace later
    elif provider_key == 'grok':
        # Placeholder for Grok/xAI provider
        return OpenAIClient(api_key_env='GROK_API_KEY')  # reuse wrapper as placeholder
    else:
        # Fallback
        return OpenAIClient()
